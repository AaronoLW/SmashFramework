<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.0.2</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Authors>AaronoLW</Authors>
    <Copyright>Copyright 2026 AaronoLW</Copyright>
    <RepositoryUrl>https://github.com/AaronoLW/SmashFramework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>A very simple framework for making games/graphical applications built on top of SDL3</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="SDL3-CS" Version="3.4.18" />
	  <PackageReference Include="SDL3-CS.Native" Version="3.4.2" />
	  <PackageReference Include="SDL3-CS.Native.Image" Version="3.5.0" />
	  <PackageReference Include="SDL3-CS.Native.TTF" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
   <None Include="README.md" Pack="true" PackagePath="\" />
   <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
